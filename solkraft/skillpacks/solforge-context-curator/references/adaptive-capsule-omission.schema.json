{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.solforge/adaptive-capsule-omission.schema.json",
  "title": "SolForge adaptive capsule omission manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "roleId", "complete", "items", "omissionHash"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "roleId": { "enum": ["context_curator", "route_architect", "prompt_compiler", "independent_challenger", "contract_validator"] },
    "complete": { "const": true },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "id", "sha256", "reason", "materiality"],
        "properties": {
          "category": { "enum": ["skill", "tool", "evidence"] },
          "id": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "reason": { "type": "string", "minLength": 1 },
          "materiality": { "type": "string", "minLength": 1 }
        }
      }
    },
    "omissionHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
