{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.solforge/adaptive-capsule-recipe.schema.json",
  "title": "SolForge adaptive capsule recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "catalogVersion", "templateId", "templateHash", "effortId", "activeRoleIds", "preferredMode", "allowedModes", "passesByRole", "roleBudgets", "completionUnitEstimate", "specialistsRecommendOnly", "authorityExpansionAuthorized", "recipeHash"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "solforge-adaptive-capsule-recipe" },
    "catalogVersion": { "const": "solforge-capsule-recipes-v1" },
    "templateId": { "type": "string", "minLength": 1 },
    "templateHash": { "$ref": "#/$defs/hash" },
    "effortId": { "enum": ["low", "medium", "high", "extra"] },
    "activeRoleIds": { "type": "array", "items": { "$ref": "#/$defs/role" }, "minItems": 1, "uniqueItems": true },
    "preferredMode": { "enum": ["host_native_subagents", "deterministic_specialists"] },
    "allowedModes": { "type": "array", "items": { "enum": ["host_native_subagents", "deterministic_specialists"] }, "minItems": 1, "uniqueItems": true },
    "passesByRole": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } },
    "roleBudgets": { "type": "object", "minProperties": 5 },
    "completionUnitEstimate": { "type": "object", "required": ["estimatedUnits", "minimumUnits", "maximumUnits", "estimateHash"] },
    "specialistsRecommendOnly": { "const": true },
    "authorityExpansionAuthorized": { "const": false },
    "recipeHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "role": { "enum": ["context_curator", "route_architect", "prompt_compiler", "independent_challenger", "contract_validator"] }
  }
}
