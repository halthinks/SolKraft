{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "validation_mode", "capsule_sha256", "capability_attestation", "limits", "kill_switch", "lease_policy", "authorization"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "validation_mode": {"enum": ["production", "proof_only_fixture"]},
    "capsule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capability_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "capability", "verified", "provider", "proof_id", "issued_at", "expires_at", "max_agents", "runtime_config_sha256", "signature_algorithm", "key_id", "signature", "verification_receipt_sha256", "attestation_sha256"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "capability": {"const": "native_ultra"},
        "verified": {"const": true},
        "provider": {"type": "string", "minLength": 1},
        "proof_id": {"type": "string", "minLength": 1},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "max_agents": {"type": "integer", "minimum": 2},
        "runtime_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signature_algorithm": {"enum": ["hmac-sha256", "proof-only-hmac-sha256"]},
        "key_id": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verification_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_elapsed_seconds", "max_tool_calls", "max_rounds", "max_agents", "max_cost_usd"],
      "properties": {
        "max_elapsed_seconds": {"type": "integer", "minimum": 1},
        "max_tool_calls": {"type": "integer", "minimum": 1},
        "max_rounds": {"type": "integer", "minimum": 1},
        "max_agents": {"type": "integer", "minimum": 2},
        "max_cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "kill_switch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["armed", "controller", "mechanism", "authority_expansion_allowed", "activation_receipt_sha256"],
      "properties": {
        "armed": {"const": true},
        "controller": {"const": "user"},
        "mechanism": {"enum": ["terminate", "cancel"]},
        "authority_expansion_allowed": {"const": false},
        "activation_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "lease_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_active_leases", "bounded_units_per_lease", "checkpoint_before_reacquire", "sha256_chain_required", "receipt_sha256"],
      "properties": {
        "max_active_leases": {"const": 1},
        "bounded_units_per_lease": {"const": 1},
        "checkpoint_before_reacquire": {"const": true},
        "sha256_chain_required": {"const": true},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized_by", "confirmation_text", "confirmed_at", "capsule_sha256", "budget_sha256", "signature_algorithm", "key_id", "signature", "receipt_sha256"],
      "properties": {
        "authorized_by": {"const": "user"},
        "confirmation_text": {"type": "string", "minLength": 1},
        "confirmed_at": {"type": "string", "format": "date-time"},
        "capsule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "budget_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signature_algorithm": {"enum": ["hmac-sha256", "proof-only-hmac-sha256"]},
        "key_id": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["old_budget_sha256", "new_budget_sha256", "reason", "authorized_by", "confirmation_text", "confirmed_at", "signature_algorithm", "key_id", "signature", "receipt_sha256"],
      "properties": {
        "old_budget_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "new_budget_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reason": {"type": "string", "minLength": 1},
        "authorized_by": {"const": "user"},
        "confirmation_text": {"type": "string", "minLength": 1},
        "confirmed_at": {"type": "string", "format": "date-time"},
        "signature_algorithm": {"enum": ["hmac-sha256", "proof-only-hmac-sha256"]},
        "key_id": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
