{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solforge.local/schemas/multi-agent-registry-v1.json",
  "title": "SolForge Run Multi Agent Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "capsule_sha256", "real_agent_capability", "root_agent_id", "requirement_ids", "agents", "workstreams", "handoffs", "integrated_verification"],
  "properties": {
    "profile": {"const": "multi"},
    "capsule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "real_agent_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "evidence"],
      "properties": {
        "verified": {"const": true},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "root_agent_id": {"type": "string", "minLength": 1},
    "requirement_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^\\S+$"}
    },
    "agents": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["agent_id", "role", "status"],
        "properties": {
          "agent_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "status": {"enum": ["running", "idle", "completed", "blocked", "failed", "interrupted"]}
        }
      }
    },
    "workstreams": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["workstream_id", "owner_agent_id", "task", "requirement_ids", "authorization_basis", "resources", "status"],
        "properties": {
          "workstream_id": {"type": "string", "minLength": 1},
          "owner_agent_id": {"type": "string", "minLength": 1},
          "task": {"type": "string", "minLength": 1},
          "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "authorization_basis": {"type": "string", "minLength": 1},
          "resources": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["resource", "access"],
              "properties": {
                "resource": {"type": "string", "minLength": 1},
                "access": {"enum": ["read", "write"]}
              }
            }
          },
          "status": {"enum": ["pending", "active", "blocked", "failed", "complete", "integrated"]}
        }
      }
    },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["handoff_id", "workstream_id", "from_agent_id", "to_agent_id", "task", "scope", "access_classification", "authorization_basis", "requirement_ids", "commands_tools", "started_at", "completed_at", "status", "results", "evidence", "uncertainties", "next_safe_action"],
        "properties": {
          "handoff_id": {"type": "string", "minLength": 1},
          "workstream_id": {"type": "string", "minLength": 1},
          "from_agent_id": {"type": "string", "minLength": 1},
          "to_agent_id": {"type": "string", "minLength": 1},
          "task": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "access_classification": {"enum": ["read", "write", "mixed"]},
          "authorization_basis": {"type": "string", "minLength": 1},
          "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "commands_tools": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "started_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": "string", "format": "date-time"},
          "status": {"enum": ["completed", "blocked", "failed"]},
          "results": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "locator", "claim"],
              "properties": {
                "kind": {"enum": ["command_output", "diff", "test_result", "artifact", "tool_result"]},
                "locator": {"type": "string", "minLength": 1},
                "claim": {"type": "string", "minLength": 1}
              }
            }
          },
          "uncertainties": {"type": "array", "items": {"type": "string"}},
          "next_safe_action": {"type": "string", "minLength": 1}
        }
      }
    },
    "integrated_verification": {
      "type": "object", "additionalProperties": false,
      "required": ["performed_by_root", "evidence", "adversarial_audit"],
      "properties": {
        "performed_by_root": {"type": "boolean"},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "adversarial_audit": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
