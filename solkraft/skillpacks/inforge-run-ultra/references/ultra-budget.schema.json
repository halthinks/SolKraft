{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["capsule_sha256", "native_ultra_verified", "limits", "authorization"],
  "properties": {
    "capsule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "native_ultra_verified": {"const": true},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_elapsed_seconds", "max_tool_calls", "max_rounds", "max_agents", "max_cost_usd"],
      "properties": {
        "max_elapsed_seconds": {"type": "integer", "minimum": 1},
        "max_tool_calls": {"type": "integer", "minimum": 1},
        "max_rounds": {"type": "integer", "minimum": 1},
        "max_agents": {"type": "integer", "minimum": 1},
        "max_cost_usd": {"type": "number", "minimum": 0}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized_by", "confirmation_text", "confirmed_at", "capsule_sha256", "budget_sha256"],
      "properties": {
        "authorized_by": {"const": "user"},
        "confirmation_text": {"type": "string", "minLength": 1},
        "confirmed_at": {"type": "string", "minLength": 1},
        "capsule_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "budget_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "extension": {
      "type": "object",
      "required": ["old_budget_sha256", "new_budget_sha256", "reason", "authorized_by", "confirmation_text"],
      "properties": {
        "old_budget_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "new_budget_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reason": {"type": "string", "minLength": 1},
        "authorized_by": {"const": "user"},
        "confirmation_text": {"type": "string", "minLength": 1}
      }
    }
  }
}
