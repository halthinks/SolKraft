{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solforge.local/schemas/code-research-result-v1.json",
  "title": "SolForge Code Research result",
  "type": "object",
  "required": [
    "scopeAndRepositoryGraph",
    "evidence",
    "explicitIntent",
    "inferredDesign",
    "capabilityMap",
    "inconsistencies",
    "coverage",
    "completionGaps",
    "endState",
    "remediationSteps",
    "criticFindings",
    "falsificationProbes",
    "regressionAnalysis",
    "semanticAlignment",
    "uncertainties",
    "implementationHandoff",
    "completionClaim",
    "mutations",
    "externalEffects",
    "sourceRevision"
  ],
  "properties": {
    "scopeAndRepositoryGraph": {
      "type": "object",
      "required": [
        "repositories"
      ],
      "properties": {
        "repositories": {
          "type": "array",
          "minItems": 1
        },
        "exclusions": {
          "type": "array"
        },
        "focusBoundary": {
          "type": "object",
          "required": [
            "included",
            "excluded",
            "regressionBoundary",
            "affectedContracts",
            "affectedDependents",
            "outOfBoundaryDependencies"
          ],
          "properties": {
            "included": {
              "$ref": "#/$defs/nonEmptyStrings"
            },
            "excluded": {
              "$ref": "#/$defs/nonEmptyStrings"
            },
            "regressionBoundary": {
              "$ref": "#/$defs/nonEmptyStrings"
            },
            "affectedContracts": {
              "$ref": "#/$defs/nonEmptyStrings"
            },
            "affectedDependents": {
              "$ref": "#/$defs/nonEmptyStrings"
            },
            "outOfBoundaryDependencies": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/nonBlank"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "explicitIntent": {
      "$ref": "#/$defs/materialArray"
    },
    "inferredDesign": {
      "type": "array",
      "minItems": 0,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/material"
          },
          {
            "type": "object",
            "required": [
              "confidence",
              "contraryEvidenceIds"
            ],
            "properties": {
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "contraryEvidenceIds": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/nonBlank"
                },
                "uniqueItems": true
              },
              "contraryEvidenceSearchBoundary": {
                "$ref": "#/$defs/nonBlank"
              }
            }
          }
        ]
      }
    },
    "capabilityMap": {
      "$ref": "#/$defs/materialArray"
    },
    "inconsistencies": {
      "$ref": "#/$defs/materialArray"
    },
    "coverage": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "layer",
          "status",
          "explanation",
          "evidenceIds"
        ],
        "properties": {
          "layer": {
            "$ref": "#/$defs/nonBlank"
          },
          "status": {
            "enum": [
              "covered",
              "not_applicable",
              "blocker"
            ]
          },
          "explanation": {
            "$ref": "#/$defs/nonBlank"
          },
          "evidenceIds": {
            "$ref": "#/$defs/evidenceIds"
          }
        },
        "additionalProperties": true
      }
    },
    "completionGaps": {
      "$ref": "#/$defs/materialArray"
    },
    "endState": {
      "$ref": "#/$defs/materialArray"
    },
    "remediationSteps": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/remediationStep"
      }
    },
    "criticFindings": {
      "type": "array",
      "minItems": 0,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/material"
          },
          {
            "type": "object",
            "required": [
              "challenge",
              "disposition"
            ],
            "properties": {
              "challenge": {
                "$ref": "#/$defs/nonBlank"
              },
              "disposition": {
                "$ref": "#/$defs/nonBlank"
              }
            }
          }
        ]
      }
    },
    "falsificationProbes": {
      "type": "array",
      "minItems": 0,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/material"
          },
          {
            "type": "object",
            "required": [
              "hypothesis",
              "method",
              "outcome"
            ],
            "properties": {
              "hypothesis": {
                "$ref": "#/$defs/nonBlank"
              },
              "method": {
                "$ref": "#/$defs/nonBlank"
              },
              "outcome": {
                "$ref": "#/$defs/nonBlank"
              }
            }
          }
        ]
      }
    },
    "regressionAnalysis": {
      "type": "array",
      "minItems": 0,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/material"
          },
          {
            "type": "object",
            "required": [
              "boundary",
              "risk",
              "tests"
            ],
            "properties": {
              "boundary": {
                "$ref": "#/$defs/nonBlank"
              },
              "risk": {
                "$ref": "#/$defs/nonBlank"
              },
              "tests": {
                "$ref": "#/$defs/nonEmptyStrings"
              },
              "focusBoundaryRefs": {
                "$ref": "#/$defs/nonEmptyStrings"
              }
            }
          }
        ]
      }
    },
    "semanticAlignment": {
      "$ref": "#/$defs/materialArray"
    },
    "uncertainties": {
      "$ref": "#/$defs/materialArray"
    },
    "implementationHandoff": {
      "type": "object",
      "required": [
        "implementationAuthorized"
      ],
      "properties": {
        "implementationAuthorized": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "completionClaim": {
      "type": "object",
      "required": [
        "status",
        "boundary"
      ],
      "properties": {
        "status": {
          "enum": [
            "qualified_complete",
            "incomplete"
          ]
        },
        "boundary": {
          "$ref": "#/$defs/nonBlank"
        },
        "designEnvelopeHash": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": true
    },
    "mutations": {
      "type": "array",
      "maxItems": 0,
      "minItems": 0
    },
    "externalEffects": {
      "type": "array",
      "maxItems": 0,
      "minItems": 0
    },
    "sourceRevision": {
      "type": "string",
      "description": "Observed source revision or explicit unavailable status."
    }
  },
  "additionalProperties": true,
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonBlank": {
      "type": "string",
      "pattern": "\\S"
    },
    "repositoryRelativePath": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).*\\S.*$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonBlank"
      }
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonBlank"
      }
    },
    "material": {
      "type": "object",
      "required": [
        "id",
        "evidenceIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonBlank"
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      },
      "additionalProperties": true
    },
    "materialArray": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/material"
      }
    },
    "remediationStep": {
      "allOf": [
        {
          "$ref": "#/$defs/material"
        },
        {
          "type": "object",
          "required": [
            "gapIds",
            "skillId",
            "toolRoute",
            "prerequisites",
            "dependsOnStepIds",
            "risks",
            "verification",
            "rollback",
            "acceptance",
            "plainLanguage",
            "stopConditions",
            "landing",
            "intendedMutations",
            "testCommands"
          ],
          "properties": {
            "gapIds": {
              "$ref": "#/$defs/nonEmptyStrings"
            },
            "skillId": {
              "$ref": "#/$defs/nonBlank"
            },
            "toolRoute": {
              "$ref": "#/$defs/nonBlank"
            },
            "prerequisites": {
              "$ref": "#/$defs/nonEmptyStrings"
            },
            "dependsOnStepIds": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/nonBlank"
              },
              "uniqueItems": true
            },
            "risks": {
              "$ref": "#/$defs/nonEmptyStrings"
            },
            "verification": {
              "$ref": "#/$defs/nonBlank"
            },
            "rollback": {
              "$ref": "#/$defs/nonBlank"
            },
            "acceptance": {
              "$ref": "#/$defs/nonBlank"
            },
            "plainLanguage": {
              "type": "object",
              "required": [
                "currentFailure",
                "exactChange",
                "observableOutcome",
                "check",
                "remainingUnproved"
              ],
              "properties": {
                "currentFailure": {
                  "$ref": "#/$defs/nonBlank"
                },
                "exactChange": {
                  "$ref": "#/$defs/nonBlank"
                },
                "observableOutcome": {
                  "$ref": "#/$defs/nonBlank"
                },
                "check": {
                  "$ref": "#/$defs/nonBlank"
                },
                "remainingUnproved": {
                  "$ref": "#/$defs/nonBlank"
                }
              },
              "additionalProperties": false
            },
            "stopConditions": {
              "$ref": "#/$defs/nonEmptyStrings"
            },
            "landing": {
              "$ref": "#/$defs/nonBlank"
            },
            "intendedMutations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "repositoryId",
                  "path"
                ],
                "properties": {
                  "repositoryId": {
                    "$ref": "#/$defs/nonBlank"
                  },
                  "path": {
                    "$ref": "#/$defs/repositoryRelativePath"
                  }
                },
                "additionalProperties": false
              }
            },
            "testCommands": {
              "type": "object",
              "required": [
                "focused"
              ],
              "properties": {
                "focused": {
                  "$ref": "#/$defs/repositoryTestCommands"
                },
                "regression": {
                  "$ref": "#/$defs/optionalRepositoryTestCommands"
                },
                "adversarial": {
                  "$ref": "#/$defs/optionalRepositoryTestCommands"
                },
                "full_suite": {
                  "$ref": "#/$defs/optionalRepositoryTestCommands"
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "repositoryTestCommands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "repositoryId",
          "command"
        ],
        "properties": {
          "repositoryId": {
            "$ref": "#/$defs/nonBlank"
          },
          "command": {
            "$ref": "#/$defs/nonBlank"
          }
        },
        "additionalProperties": false
      }
    },
    "optionalRepositoryTestCommands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repositoryTestCommands/items"
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "locator",
        "observationMethod",
        "result",
        "verificationStatus"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonBlank"
        },
        "locator": {
          "$ref": "#/$defs/nonBlank"
        },
        "observationMethod": {
          "$ref": "#/$defs/nonBlank"
        },
        "result": {
          "$ref": "#/$defs/nonBlank"
        },
        "verificationStatus": {
          "$ref": "#/$defs/nonBlank"
        },
        "coverageLayers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonBlank"
          },
          "uniqueItems": true
        },
        "claimType": {
          "enum": [
            "presence",
            "absence"
          ]
        },
        "absenceBoundary": {
          "$ref": "#/$defs/nonBlank"
        }
      },
      "additionalProperties": true
    }
  }
}
