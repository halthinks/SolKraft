{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["capsule_id", "scope", "authorization", "budgets", "retry_limit", "source_artifacts"],
  "properties": {
    "capsule_id": {"type": "string", "minLength": 1},
    "scope": {"type": "object", "additionalProperties": false, "required": ["in_scope", "out_of_scope"], "properties": {"in_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "authorization": {"type": "object", "additionalProperties": false, "required": ["allowed_actions", "prohibited_actions", "allowed_tools", "permission_evidence", "mutation_allowed", "external_side_effects_allowed"], "properties": {
      "allowed_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "prohibited_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
      "allowed_tools": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "permission_evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["permission", "basis", "evidence"], "properties": {"permission": {"type": "string", "minLength": 1}, "basis": {"enum": ["user_explicit", "derived_nonexpansive", "higher_priority_policy"]}, "evidence": {"type": "string", "minLength": 1}}}},
      "mutation_allowed": {"type": "boolean"},
      "external_side_effects_allowed": {"type": "boolean"}
    }},
    "budgets": {"type": "object", "additionalProperties": false, "required": ["max_elapsed_seconds", "max_tool_calls", "max_rounds", "max_agents", "max_cost_usd"], "properties": {
      "max_elapsed_seconds": {"type": "number", "exclusiveMinimum": 0}, "max_tool_calls": {"type": "integer", "minimum": 1}, "max_rounds": {"type": "integer", "minimum": 1}, "max_agents": {"type": "integer", "minimum": 2}, "max_cost_usd": {"type": "number", "minimum": 0}
    }},
    "retry_limit": {"type": "integer", "minimum": 0},
    "source_artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
