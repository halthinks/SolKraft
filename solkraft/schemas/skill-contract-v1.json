{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solkraft.dev/schemas/skill-contract-v1.json",
  "title": "SolKraft Skill Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill_id",
    "contract_revision"
  ],
  "properties": {
    "schema_version": {
      "type": [
        "string",
        "integer"
      ],
      "pattern": "^1(?:\\\\.[0-9]+)?$"
    },
    "skill_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_revision": {
      "type": "integer",
      "minimum": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": [
          "object",
          "string"
        ]
      },
      "default": []
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": [
          "object",
          "string"
        ]
      },
      "default": []
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "legacy_scope": {
          "enum": [
            "none",
            "read",
            "write-local",
            "network",
            "external-effect"
          ]
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "default": []
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
